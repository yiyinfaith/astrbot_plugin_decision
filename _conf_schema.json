{
  "provider": {
    "type": "string",
    "description": "决策服务",
    "options": ["systemone_jev"],
    "default": "systemone_jev"
  },
  "base_url": {
    "type": "string",
    "description": "服务地址",
    "default": ""
  },
  "systemone_path": {
    "type": "string",
    "description": "API 路径",
    "default": "/v1/systemone"
  },
  "api_key": {
    "type": "string",
    "description": "API 密钥",
    "secret": true,
    "default": ""
  },
  "model": {
    "type": "string",
    "description": "Jev 模型",
    "default": "jev-latest"
  },
  "timeout_sec": {
    "type": "float",
    "description": "请求超时（秒）",
    "default": 5.0
  },
  "retries": {
    "type": "int",
    "description": "最大重试次数",
    "hint": "不含首次请求；默认 1，设为 0 表示失败后不重试。",
    "default": 1
  },
  "retry_backoff_seconds": {
    "type": "float",
    "description": "重试间隔（秒）",
    "hint": "默认 0 秒，立即重试。",
    "default": 0.0
  },
  "model_context_tokens": {
    "type": "int",
    "description": "上下文上限（Token）",
    "hint": "默认 32000；主动对话超限时裁剪历史，工具判断超限时自动分批。",
    "default": 32000
  },
  "history_max_messages": {
    "type": "int",
    "description": "上下文消息数",
    "default": 8
  },
  "history_max_chars": {
    "type": "int",
    "description": "上下文字符数",
    "default": 6000
  },
  "tools_subagents_decision_enabled": {
    "type": "bool",
    "description": "Tool/MCP/Skill/SubAgent 决策",
    "hint": "控制 Tool、MCP、Skill 和 SubAgent 的 Jev 判断；不影响主动对话。",
    "default": true
  },
  "proactive_reply_enabled": {
    "type": "bool",
    "description": "主动对话",
    "hint": "只对白名单内的群聊和私聊启用主动对话判断。详细配置在插件 WebUI。",
    "default": false
  },
  "conversation_flow_enabled": {
    "type": "bool",
    "description": "对话流增强",
    "hint": "控制输入增强和输出增强；详细配置在插件 WebUI。",
    "default": true
  }
}
